{
	"name": "badpool-tracker",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:local": "concurrently --kill-others --names azurite,swa --prefix-colors blue,green \"pnpm dev:storage\" \"pnpm dev:swa\"",
		"dev:storage": "azurite --silent --location .azurite",
		"dev:swa": "swa start",
		"build": "vite build",
		"preview": "vite preview",
		"extract": "python3 scripts/extract.py",
		"table:dump": "node api/scripts/dump-table.js",
		"test": "vitest run"
	},
	"devDependencies": {
		"@azure/static-web-apps-cli": "^2.0.10",
		"@vitejs/plugin-vue": "^6.0.9",
		"@vue/test-utils": "^2.5.0",
		"azurite": "^3.37.0",
		"concurrently": "^10.0.5",
		"happy-dom": "^20.14.5",
		"vite": "8.3.0",
		"vitest": "^3.0.0"
	},
	"dependencies": {
		"vue": "^3.5.42"
	}
}
