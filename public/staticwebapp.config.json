{
	"$schema": "https://json.schemastore.org/staticwebapp.config.json",
	"routes": [
		{
			"route": "/api/*",
			"allowedRoles": ["authenticated"]
		},
		{
			"route": "/.auth/login/aad",
			"statusCode": 404
		},
		{
			"route": "/.auth/login/twitter",
			"statusCode": 404
		},
		{
			"route": "/login",
			"rewrite": "/.auth/login/github"
		}
	],
	"responseOverrides": {
		"401": {
			"statusCode": 401,
			"rewrite": "/401.json"
		}
	},
	"globalHeaders": {
		"X-Content-Type-Options": "nosniff",
		"X-Frame-Options": "DENY",
		"Referrer-Policy": "strict-origin-when-cross-origin",
		"Strict-Transport-Security": "max-age=31536000",
		"Content-Security-Policy": "default-src 'self'; script-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
	},
	"mimeTypes": {
		".json": "application/json"
	}
}
